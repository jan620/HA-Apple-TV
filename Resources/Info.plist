<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Home Assistant</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Home Assistant is usually reachable only over plain HTTP on the LAN.
	     NSAllowsLocalNetworking permits that for .local names and private IP
	     ranges without weakening TLS for anything else. Instances published
	     over plain HTTP on a *public* hostname additionally need
	     NSAllowsArbitraryLoads, which is intentionally not set here. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- tvOS gates local network traffic and Bonjour behind an explicit
	     user prompt; both keys are required for discovery to work. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Zum Finden und Steuern deiner Home Assistant Instanz im Heimnetzwerk.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_home-assistant._tcp</string>
	</array>
</dict>
</plist>
